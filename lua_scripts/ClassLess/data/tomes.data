-- ALT SOURCES -- GENERATED by scratchpad/alt_sources.py, regenerate, do not hand-edit.
--
-- A second creature carrying an ALREADY EXISTING tome, added where a zone had too
-- few for anyone levelling there to actually find abilities. Same item id as the
-- primary in CLDB.tomes -- reading either teaches the same rank. Kept in its own
-- table so CLDB.tomes stays exactly what rank_sources.py produced.
--
-- CLDB.altsources[rankSpellId] = { {srcEntry, srcName, place, srcLevel}, ... }
if CLDB.altsources==nil then CLDB.altsources={} end

CLDB.altsources={
