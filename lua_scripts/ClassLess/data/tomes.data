--TOMES
-- GENERATED by scratchpad/rank_sources.py -- regenerate, do not hand-edit.
--
-- One tome per ABILITY RANK. Fireball rank 4 is a different book from rank
-- 3, found on a different creature, at roughly the level that rank becomes
-- usable. Using it unlocks EXACTLY that rank.
--
-- CLDB.tomes[rankSpellId] = { itemId, kind, srcEntry, srcName, place,
--                             level, srcLevel }
--   kind: "b" dungeon boss, "c" creature, "q" quest,
--         "s" starter -- granted at creation, so it has NO source and never
--         drops; srcEntry/srcName/place are empty.
--   level    = the level this RANK becomes usable at
--   srcLevel = the level of the mob or quest carrying it, i.e. when you can
--              realistically go and get it. The journal sorts on srcLevel.
--
-- CLDB.rarebuffs[LINE id] = true for the 68 pre-cast buffs -- keyed by LINE,
-- not by rank, because the restriction applies to the whole chain: every
-- rank of one comes off a dungeon boss and binds on pickup. These are the
-- buffs nothing else makes exclusive, so acquisition is the only brake left
-- on stacking them. Derived -- see scratchpad/buff_rarity.py.
--
-- CLDB.lineof[rankSpellId] = line id, so the client can group ranks without
-- walking both spell trees.

if CLDB==nil then CLDB={} end
if CLDB.tomes==nil then CLDB.tomes={} end
if CLDB.rarebuffs==nil then CLDB.rarebuffs={} end
if CLDB.lineof==nil then CLDB.lineof={} end

