--BOUNTIES
-- GENERATED by scratchpad/bounty_quests.py -- regenerate, do not hand-edit.
--
-- One bounty per tome-carrying CREATURE (not per rank -- a creature carrying
-- several tomes still gets one quest). Deliberately excludes "q" (quest-sourced)
-- and "s" (starter) rows from tomes.data: neither has a killable creature source.
--
-- CLDB.bounties[creatureEntry] = { itemId, questId, "name", "place", level, rank }
-- rank is creature_template.rank (CreatureEliteType): 0 normal, 1 elite,
-- 2 rareelite, 3 worldboss, 4 rare. Server.lua weights draws toward rank>=1.

if CLDB==nil then CLDB={} end
if CLDB.bounties==nil then CLDB.bounties={} end

